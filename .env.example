NEXT_PUBLIC_DOC_URL=https://docs.canvas.best

# Invite-only account bootstrap. Set these only in the server secret file, never in the browser.
# The first successful account request creates this root user. Registration remains invite-only.
CANVAS_ROOT_USERNAME=root
CANVAS_ROOT_PASSWORD=
CANVAS_SESSION_SECRET=
CANVAS_SESSION_TTL_DAYS=7
AUTH_DATA_DIR=/app/data/auth
