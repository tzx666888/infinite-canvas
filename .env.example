NEXT_PUBLIC_DOC_URL=https://docs.canvas.best

# Set this only in the server secret file, never in the browser or image.
CANVAS_AUTH_SHARED_SECRET=
CANVAS_UPSTREAM_ORIGIN=http://127.0.0.1:3000
CANVAS_UPSTREAM_API_KEY=
CANVAS_SESSION_SECRET=
CANVAS_API_KEY_PEPPER=
CANVAS_SESSION_TTL_DAYS=1
AUTH_DATA_DIR=/app/data/auth
IMAGE_JOB_DIR=/app/data/image-jobs
CANVAS_BOOTSTRAP_ROOT_USERNAME=root
CANVAS_BOOTSTRAP_ROOT_PASSWORD=
CANVAS_BOOTSTRAP_ROOT_CREDITS=0
CANVAS_INVITE_INITIAL_CREDITS=0
CANVAS_BILLING_ENABLED=true
CANVAS_MODEL_PRICES_JSON={}

# Payment gateway credentials stay in the server secret file. They are never sent to the browser.
CANVAS_EPAY_ADDRESS=
CANVAS_EPAY_PARTNER_ID=
CANVAS_EPAY_KEY=
CANVAS_EPAY_METHODS=[]
CANVAS_EPAY_AMOUNT_OPTIONS=[]
CANVAS_CREDITS_PER_YUAN=10
