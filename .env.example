NEXT_PUBLIC_DOC_URL=https://docs.canvas.best

# Existing TokAxis/New API accounts are verified through a private loopback bridge.
# Set this only in the server secret file, never in the browser or image.
CANVAS_AUTH_SHARED_SECRET=
TOKAXIS_INTERNAL_ORIGIN=http://127.0.0.1:3000
CANVAS_SESSION_SECRET=
CANVAS_SESSION_TTL_DAYS=1
AUTH_DATA_DIR=/app/data/auth
